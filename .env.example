# === Base de datos (TimescaleDB / PostgreSQL) ===
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=markettracker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Orígenes permitidos para CORS (separados por coma). "*" = todos (solo dev).
CORS_ORIGINS=*

# === Autenticación (JWT) ===
# IMPORTANTE: pon una cadena larga y aleatoria (p. ej. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production
# Caducidad del token en minutos (por defecto 7 días).
JWT_EXPIRE_MINUTES=10080
# Permitir registro abierto de usuarios. Ponlo a false para cerrar el alta
# tras crear tu usuario (se permite siempre crear el primero).
ALLOW_REGISTRATION=true

# === Ingestión ===
# Proveedor de cripto en tiempo real (WebSocket público, gratis)
CRYPTO_WS_URL=wss://stream.binance.com:9443/ws
# Símbolos iniciales a seguir (separados por coma). En binance minúsculas.
DEFAULT_CRYPTO_SYMBOLS=btcusdt,ethusdt

# === Notificaciones (Telegram) ===
# Crea un bot con @BotFather y obtén el token. El chat_id es el de tu chat/grupo.
# Si se dejan vacíos, las alertas solo se registran en el log (no se envían).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watchdog: segundos sin recibir ticks antes de avisar de ingestión caída.
INGESTION_STALE_SECONDS=120

# === Twelve Data (acciones y forex) ===
# API key del plan gratuito: https://twelvedata.com  (sin WebSocket -> polling REST).
# Si se deja vacía, solo se ingiere cripto (Binance).
TWELVE_DATA_API_KEY=
# Cada cuántos segundos se consulta el precio (plan free ~8 req/min).
TWELVE_DATA_POLL_SECONDS=60
