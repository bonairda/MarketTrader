# === Base de datos (TimescaleDB / PostgreSQL) ===
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=markettracker
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alternativa: URL completa (útil con proveedores gestionados/Coolify).
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternativa con autenticación: redis://:password@host:6379/0
# REDIS_URL=redis://redis:6379/0

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=local
DOCS_ENABLED=true
LOG_LEVEL=INFO
# Orígenes permitidos para CORS (separados por coma). "*" = todos (solo dev).
CORS_ORIGINS=*

# === Autenticación (JWT) ===
# IMPORTANTE: pon una cadena larga y aleatoria (p. ej. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production
# Caducidad del token en minutos (por defecto 7 días).
JWT_EXPIRE_MINUTES=10080
# Permitir registro abierto de usuarios. Ponlo a false para cerrar el alta
# tras crear tu usuario (se permite siempre crear el primero).
ALLOW_REGISTRATION=true

# === Ingestión ===
# Proveedor de cripto en tiempo real (WebSocket público, gratis)
CRYPTO_WS_URL=wss://stream.binance.com:9443/ws
# Símbolos iniciales a seguir (separados por coma). En binance minúsculas.
DEFAULT_CRYPTO_SYMBOLS=btcusdt,ethusdt

# === Tipos de cambio (Banco Central Europeo) ===
# Feeds públicos usados para autorrellenar el cambio a EUR de las operaciones.
ECB_FX_DAILY_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
ECB_FX_HISTORY_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist-90d.xml
ECB_FX_CACHE_TTL_SECONDS=43200

# === Paper trading (Alpaca, SIN dinero real) ===
# Opt-in: deshabilitado si no hay credenciales. Usa SIEMPRE el host de paper.
ALPACA_ENABLED=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Notificaciones (Telegram) ===
# Bot ÚNICO del sistema: crea uno con @BotFather y pega aquí su token.
# - TELEGRAM_BOT_TOKEN habilita que CADA usuario vincule su propio chat desde la
#   app (ajustes de Notificaciones) y reciba SUS alertas solo él.
# - TELEGRAM_CHAT_ID es el chat GLOBAL para avisos operativos (watchdog/admin).
# Si se dejan vacíos, las alertas solo se registran en el log (no se envían).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secreto opcional del webhook del bot. Si se define, el endpoint
# /notifications/telegram/webhook exige el header de secret que envía Telegram.
TELEGRAM_WEBHOOK_SECRET=

# === Superadministrador (bootstrap) ===
# Si defines ambos, al arrancar la API se crea/actualiza este usuario con rol
# SUPERADMIN (idempotente). Podrá crear usuarios y asignar roles desde el panel
# de administración de la app. Deja SUPERADMIN_PASSWORD vacío para no gestionarlo.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Watchdog: segundos sin recibir ticks antes de avisar de ingestión caída.
INGESTION_STALE_SECONDS=120
WORKER_HEARTBEAT_TTL_SECONDS=30

# === Twelve Data (acciones y forex) ===
# API key del plan gratuito: https://twelvedata.com  (sin WebSocket -> polling REST).
# Si se deja vacía, solo se ingiere cripto (Binance).
TWELVE_DATA_API_KEY=
# Cada cuántos segundos se consulta el precio (plan free ~8 req/min).
TWELVE_DATA_POLL_SECONDS=60
