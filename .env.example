# === Base de datos (TimescaleDB / PostgreSQL) ===
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=markettracker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# === Ingestión ===
# Proveedor de cripto en tiempo real (WebSocket público, gratis)
CRYPTO_WS_URL=wss://stream.binance.com:9443/ws
# Símbolos iniciales a seguir (separados por coma). En binance minúsculas.
DEFAULT_CRYPTO_SYMBOLS=btcusdt,ethusdt
