# Plantilla para variables de Coolify. NO copies secretos reales al repositorio.

# Identidad del stack (usa otro nombre en staging para separar volúmenes/redes).
STACK_NAME=market-tracker-production
ENVIRONMENT=production
COOLIFY_NETWORK=coolify

# Imágenes publicadas por .github/workflows/deploy-coolify.yml.
BACKEND_IMAGE=ghcr.io/bonairda/markettrader-backend
APP_IMAGE=ghcr.io/bonairda/markettrader-web
# main para auto-deploy; usa sha-<commit> para fijar/rollback.
IMAGE_TAG=main

# Verificar linux/arm64 antes del primer despliegue.
TIMESCALE_IMAGE=timescale/timescaledb
TIMESCALE_TAG=2.16.1-pg16
REDIS_IMAGE=redis:7.4-alpine

# Base de datos (generar passwords aleatorios largos en Coolify).
POSTGRES_USER=market
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
POSTGRES_DB=markettracker
# Opcionales para una futura migración a servicios gestionados; vacíos usan
# los contenedores db/redis del Compose.
DATABASE_URL=
REDIS_URL=
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Dominios públicos. Coolify gestiona DNS/TLS; aquí solo se configuran app/API.
PUBLIC_API_BASE_URL=https://api.market.example.com
CORS_ORIGINS=https://market.example.com

# Seguridad.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRE_MINUTES=10080
# El primer usuario puede registrarse como bootstrap incluso estando en false;
# las altas posteriores quedan cerradas.
ALLOW_REGISTRATION=false
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Ingestión.
CRYPTO_WS_URL=wss://stream.binance.com:9443/ws
DEFAULT_CRYPTO_SYMBOLS=btcusdt,ethusdt
TWELVE_DATA_API_KEY=
# Los símbolos se consultan en lote (1 petición por ciclo). Con 10-15
# acciones/forex, 90s deja margen frente al límite por minuto del plan free.
TWELVE_DATA_POLL_SECONDS=90
INGESTION_STALE_SECONDS=120
WORKER_HEARTBEAT_TTL_SECONDS=30

# Notificaciones opcionales (Telegram).
# Bot único del sistema; con él cada usuario vincula su chat y recibe SUS alertas.
# TELEGRAM_CHAT_ID = chat global para avisos operativos (watchdog/admin).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Recomendado en producción: secreto del webhook del bot (marca como secreto).
TELEGRAM_WEBHOOK_SECRET=

# Superadministrador (bootstrap). Si defines ambos, al arrancar la API se
# crea/actualiza este usuario con rol SUPERADMIN. Marca la contraseña como
# secreto en Coolify. En producción debe tener al menos 12 caracteres.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=REPLACE_WITH_A_STRONG_SECRET_MIN_12

# Backups: local diario + retención. Para copia off-host, configura OCI S3.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_ON_START=false
RCLONE_REMOTE=
RCLONE_DESTINATION=
RCLONE_CONFIG_OCI_TYPE=s3
RCLONE_CONFIG_OCI_PROVIDER=Other
RCLONE_CONFIG_OCI_ACCESS_KEY_ID=
RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OCI_ENDPOINT=
RCLONE_CONFIG_OCI_REGION=
